# LLM_PROVIDER: azure | openai | none (none = retrieval only, no generation)
LLM_PROVIDER=none
# SEARCH_BACKEND: local (in-process BM25 + vectors) | azure (Azure AI Search)
SEARCH_BACKEND=local

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<service>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=coverage-chunks
# Set to coverage-semantic to use the semantic reranker (needs a tier that has it)
AZURE_SEARCH_SEMANTIC_CONFIG=

# OpenAI-compatible endpoint for local mode
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

TOP_K=5
MIN_SCORE=0.50

# Free OpenAI-compatible options (chat only: leave OPENAI_EMBEDDING_MODEL empty to turn vectors off)
#   Groq:   OPENAI_BASE_URL=https://api.groq.com/openai/v1        OPENAI_CHAT_MODEL=llama-3.3-70b-versatile
#   NVIDIA: OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1   OPENAI_CHAT_MODEL=meta/llama-3.3-70b-instruct
